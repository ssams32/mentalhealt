# Mind-ERP OS Environment Configuration Template
# Do NOT place production secrets or private tokens in this template.

# Server Configuration
PORT=3001
NODE_ENV=production
TZ=Asia/Seoul

# Data Directory Paths
DATA_DIR=/app/data
ATTACHMENTS_DIR=/app/attachments

# Track A1: CORS Explicit Allowlist (Comma-separated exact origins)
# Example: http://localhost:5173,http://localhost:8888,https://nas.center.local:3000
CORS_ALLOWED_ORIGINS=

# Track A1: Authentication Cookie Settings
# Set to 'true' if running behind an HTTPS reverse proxy
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=12

# Track A6/A7: Private Audio Storage (Permanent verified audio recordings, outside attachments)
PRIVATE_AUDIO_DIR=/app/private-audio

# Admin Initialization (Optional initial setup only)
ADMIN_INIT_PASSWORD=

# Track A8: Persistent Job Queue Settings (Worker auto-start disabled by default in server.js)
# NOTE: The limits below are defaults/examples subject to production sizing and capacity verification
JOB_LEASE_DURATION_MS=30000
JOB_HEARTBEAT_INTERVAL_MS=10000
JOB_MIN_HEARTBEAT_INTERVAL_MS=500
JOB_STALLED_THRESHOLD_MS=60000
JOB_HANDLER_TIMEOUT_MS=30000
JOB_SHUTDOWN_GRACE_MS=5000
JOB_RETRY_BASE_DELAY_MS=1000
JOB_RETRY_MAX_DELAY_MS=60000
JOB_QUEUE_MAX_ACTIVE=500
JOB_QUEUE_MAX_TOTAL=5000
JOB_QUEUE_MAX_PER_CALL=20
JOB_QUEUE_MAX_PER_TYPE=200

# Track A9: Persistent Notifications and Transactional Outbox (Dispatcher autostart disabled)
# NOTE: Notifications and Outbox dispatch operate strictly in-process (No email, SMS, or external networks)
NOTIFICATION_LEASE_DURATION_MS=30000
NOTIFICATION_MAX_ACTIVE_OUTBOX=500
NOTIFICATION_MAX_TOTAL_OUTBOX=5000
NOTIFICATION_MAX_TOTAL_NOTIFICATIONS=10000
NOTIFICATION_DEFAULT_EXPIRY_DAYS=30
NOTIFICATION_RETENTION_DAYS=90

# Track A10.5: Restricted Voice System Access Gate
# Master toggle for voice system subsystem (default: false)
VOICE_SYSTEM_ENABLED=false
# Voice access authorization mode: 'strict' (default) or 'allowlist' (default-deny)
VOICE_SYSTEM_ACCESS_MODE=strict
# Data directory for grants storage (defaults to DATA_DIR/voice-access or app/data/voice-access)
VOICE_SYSTEM_ACCESS_DATA_DIR=
# Internal user ID authorized for initial bootstrap grant when grant store is empty (never exposed/logged)
VOICE_SYSTEM_BOOTSTRAP_ADMIN_USER_ID=

# Track A12: Operational Readiness, JoyCall Sync Agent, and NAS Intake
# Source JoyCall recordings directory (default on local Windows client)
JOYCALL_SOURCE_DIR=C:\Program Files (x86)\JoyCall\db
# Configured NAS incoming directory for synced recordings
NAS_INCOMING_DIR=/app/nas-incoming
# JoyCall sync agent stability check interval and quiet period (ms)
JOYCALL_SYNC_POLL_INTERVAL_MS=5000
JOYCALL_SYNC_QUIET_PERIOD_MS=5000
JOYCALL_SYNC_STABILITY_CHECKS=3
# Voice AI engine toggles (Strictly disabled in Track A12 foundation)
STT_ENABLED=false
OLLAMA_ENABLED=false

# ==========================================
# Track B: Internal Online Survey Administration & Import
# ==========================================
# Explicit Track A integration mode: 'mock' (default) | 'staging' | 'production'
# - 'mock': In-memory synthetic mock collection API (for safe local development)
# - 'staging': Staging Track A service with synthetic test data only
# - 'production': Real production Track A service (requires all production variables)
SURVEY_TRACK_A_MODE=mock

# [SECURITY MANDATE]
# - NEVER put RSA private key body text into environment variables.
# - SURVEY_PRIVATE_KEY_PATH must point ONLY to a read-only PEM file on the filesystem.
# - If key file does not exist or has permission errors, server fails closed at startup (never auto-fallback).
SURVEY_PRIVATE_KEY_PATH=/run/secrets/survey_private_key

# Canonical Track A collection API base URL (e.g. https://staging-survey.center.local or https://survey.center.local)
# Staging and Production MUST use completely separated hostnames/domains.
TRACK_A_BASE_URL=

# Pre-shared server-to-server authorization secret (Bearer token)
# Specification: Authorization: Bearer <TRACK_B_SERVICE_SECRET>
# Staging and Production MUST use completely different secret keys.
TRACK_B_SERVICE_SECRET=

# Stable worker identifier (e.g. track-b-staging-worker, track-b-prod-worker-1)
TRACK_B_WORKER_ID=track-b-worker-1

# Bounded HTTP request timeout in milliseconds (default: 10000)
TRACK_A_REQUEST_TIMEOUT_MS=10000

# Maximum batch size per pull (1-100, default: 50)
TRACK_A_MAX_BATCH_SIZE=50

# Default lease duration in seconds (30-3600, default: 600)
# Set to 600s for end-to-end testing to allow PDF generation and attachment read-back verification.
TRACK_A_DEFAULT_LEASE_SECONDS=600

# SBQ-R clinical gate approval toggle (Strictly false until institutional clinical approval)
SBQR_GATE_APPROVED=false

# ──────────────────────────────────────────────────────────
# Staging vs Production Separation Checklist:
# - Staging Upstash Redis: Separate UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
# - Staging RSA Keypair: Separate key pair generated specifically for staging
# - Staging Test Data: Strictly obvious synthetic data only (SYNTHETIC 테스트사용자, 010-0000-0000)
# - Production: Zero mock/synthetic data seeding; fail closed on any missing secret/key.
# ──────────────────────────────────────────────────────────


